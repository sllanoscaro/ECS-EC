# Synthetic local values only. Never use these credentials on a VPS.
POSTGRES_USER=ecs_local
POSTGRES_PASSWORD=synthetic-local-only
POSTGRES_DB=ecs_local
DATABASE_URL=postgresql+psycopg://ecs_local:synthetic-local-only@localhost:5432/ecs_local
TEST_DATABASE_URL=postgresql+psycopg://ecs_local:synthetic-local-only@localhost:5432/ecs_test
PUBLIC_URL=http://localhost:8000
BUILDING_TIMEZONE=America/Santiago
ENVIRONMENT=local
APP_PORT=8000
DB_PORT=5432
# SMTP and technical profiles are configured by specs 008 and 007.

# Identity keys must be generated externally; no usable key is shipped in this example.
IDENTITY_ENABLED=true
IDENTITY_CSRF_KEY=
IDENTITY_LOGIN_BUCKET_KEY=
IDENTITY_CSRF_KEY_ID=csrf-v1
IDENTITY_LOGIN_BUCKET_KEY_ID=bucket-v1
IDENTITY_DEVELOPMENT_HTTP=true
IDENTITY_TRUSTED_PROXIES=[]
IDENTITY_HASH_CONCURRENCY=2
IDENTITY_BUILDING_ID=00000000-0000-0000-0000-000000000001

#007 optional technical profile. Prepare external local/test material first.
OBS_ENABLED=false
OBS_ENVIRONMENT=local
#Set to the printed environment path; never mount the CA private key into a process.
OBS_RESOURCE_ROOT=/tmp/ecs-observability-disabled
#Set to `id -u` of the owner of the prepared external resources when enabling007.
OBS_UID=10001
OBS_PORT=3443
OBS_BIND_ADDRESS=127.0.0.1
OBS_PUBLIC_URL=https://localhost:3443/grafana/
OBS_STORE_SUBNET=172.30.7.0/24
OBS_STORE_DYNAMIC_RANGE=172.30.7.128/25
OBS_GATEWAY_IP=172.30.7.2
OBS_SERVICE_VERSION=0.1.0
OBS_POLICY_REVISION=007-v1
OBS_RETENTION_HOURS=168
OBS_RETENTION=168h
OBS_TRACE_RATIO=1.0

#003 optional in-process PAS600/SFTP; provision host key/auth/bindings privately before enabling.
PAS600_SFTP_ENABLED=false
PAS600_BIND_ADDRESS=127.0.0.1
PAS600_PORT=2222
PAS600_RESOURCE_ROOT=/tmp/ecs-pas600-disabled
PAS600_MAINTENANCE_PROCESSES=
# Host maintenance CLI only; set an explicitly authorized process for install-binding/export-results.
PAS600_MAINTENANCE_PROCESS=
