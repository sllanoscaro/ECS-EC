# Synthetic local values only. Never use these credentials on a VPS.
POSTGRES_USER=ecs_local
POSTGRES_PASSWORD=synthetic-local-only
POSTGRES_DB=ecs_local
DATABASE_URL=postgresql+psycopg://ecs_local:synthetic-local-only@localhost:5432/ecs_local
TEST_DATABASE_URL=postgresql+psycopg://ecs_local:synthetic-local-only@localhost:5432/ecs_test
PUBLIC_URL=http://localhost:8000
BUILDING_TIMEZONE=America/Santiago
ENVIRONMENT=local
APP_PORT=8000
DB_PORT=5432
# SMTP and technical profiles are configured by specs 008 and 007.

# Identity keys must be generated externally; no usable key is shipped in this example.
IDENTITY_ENABLED=true
IDENTITY_CSRF_KEY=
IDENTITY_LOGIN_BUCKET_KEY=
IDENTITY_CSRF_KEY_ID=csrf-v1
IDENTITY_LOGIN_BUCKET_KEY_ID=bucket-v1
IDENTITY_DEVELOPMENT_HTTP=true
IDENTITY_TRUSTED_PROXIES=[]
IDENTITY_HASH_CONCURRENCY=2
IDENTITY_BUILDING_ID=00000000-0000-0000-0000-000000000001
